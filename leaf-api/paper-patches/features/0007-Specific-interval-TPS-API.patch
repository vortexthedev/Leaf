+++ b/src/main/java/org/bukkit/Server.java
@@ -2220,6 +2220,29 @@ public interface Server extends PluginMessageRecipient, net.kyori.adventure.audi
      */
     public double @NotNull [] getTPS();
 
+    // Gale start - specific interval TPS API
