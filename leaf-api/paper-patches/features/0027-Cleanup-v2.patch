@@ -32,7 +32,7 @@ public class PlayerHandshakeEvent extends Event implements Cancellable {
     private @Nullable UUID uniqueId;
     private @Nullable String propertiesJson;
     private boolean failed;
-    private Component failMessage = Component.text("If you wish to use IP forwarding, please enable it in your BungeeCord config as well!", NamedTextColor.YELLOW);
+    private Component failMessage;
 
     private boolean cancelled;
 
@@ -185,6 +185,8 @@ public class PlayerHandshakeEvent extends Event implements Cancellable {
      * @return the message to display to the client
      */
     public Component failMessage() {
+        if(this.failMessage == null)
+            this.failMessage = Component.text("If you wish to use IP forwarding, please enable it in your BungeeCord config as well!", NamedTextColor.YELLOW);
         return this.failMessage;
     }
 
