new file mode 100644
index 0000000000000000000000000000000000000000..e4c62928d78e812237cf1533ff39ce06022e1561
--- /dev/null
+++ b/src/main/java/org/bukkit/event/player/PlayerHealthChangeEvent.java
@@ -0,0 +1,54 @@
+package org.bukkit.event.player;
+
+import org.bukkit.entity.Player;
+import org.bukkit.event.HandlerList;
+import org.jetbrains.annotations.ApiStatus;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * Called when player's HP changes
+ */
+public class PlayerHealthChangeEvent extends PlayerEvent {
+
+    private static final HandlerList HANDLER_LIST = new HandlerList();
+
+    private final double previousHealth;
+    private final double newHealth;
+
+    @ApiStatus.Internal
+    public PlayerHealthChangeEvent(@NotNull final Player player, final double previousHealth, final double newHealth) {
+        super(player);
+        this.previousHealth = previousHealth;
+        this.newHealth = newHealth;
+    }
+
+    /**
+     * Gets the old health of player.
+     *
+     * @return the old health
+     */
+    public double getPreviousHealth() {
+        return previousHealth;
+    }
+
+    /**
+     * Gets the new health to set.
+     *
+     * @return the new health
+     */
+    public double getNewHealth() {
+        return newHealth;
+    }
+
+    @NotNull
+    @Override
+    public HandlerList getHandlers() {
+        return HANDLER_LIST;
+    }
+
+    @NotNull
+    public static HandlerList getHandlerList() {
+        return HANDLER_LIST;
+    }
+
+}
