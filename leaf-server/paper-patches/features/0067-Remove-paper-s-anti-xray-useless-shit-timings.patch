-        // not sure it's of concern here
-        try {
-            pointerInfo = MouseInfo.getPointerInfo();
-        } catch (NullPointerException | ArrayIndexOutOfBoundsException ignored) {
-            // https://bugs.openjdk.org/browse/JDK-6840067
