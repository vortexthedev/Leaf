+    public boolean setRidingPassengers(List<Entity> passengers, boolean force) {
+        if (passengers.isEmpty()) {
+            return false;
+        }
+
+        // Базовые проверки (аналог startRiding)
+        for (Entity passenger : passengers) {
+            if (passenger.vehicle == this || passenger.level != this.level) {
+                return false;
+            }
+        }
+
+        if (!this.couldAcceptPassenger()) {
+            return false;
+        }
+
+        if (!force && !this.type.canSerialize()) {
+            return false;
+        }
+
+        // Проверка на циклическое катание
+        for (Entity entity = this; entity.vehicle != null; entity = entity.vehicle) {
+            if (passengers.contains(entity)) {
+                return false;
+            }
+        }
+
+        // canRide / canAddPassenger
+        if (!force) {
+            for (Entity passenger : passengers) {
+                if (!passenger.canRide(this) || !this.canAddPassenger(passenger)) {
+                    return false;
+                }
+            }
+        }
+
+        // CraftBukkit events (ДО посадки)
+        for (Entity passenger : passengers) {
+            if (this.getBukkitEntity() instanceof org.bukkit.entity.Vehicle
+                && passenger.getBukkitEntity() instanceof org.bukkit.entity.LivingEntity) {
+
+                org.bukkit.event.vehicle.VehicleEnterEvent event =
+                    new org.bukkit.event.vehicle.VehicleEnterEvent(
+                        (org.bukkit.entity.Vehicle) this.getBukkitEntity(),
+                        passenger.getBukkitEntity()
+                    );
+
+                if (passenger.valid) {
+                    org.bukkit.Bukkit.getPluginManager().callEvent(event);
+                }
+
+                if (event.isCancelled()) {
+                    return false;
+                }
+            }
+
+            org.bukkit.event.entity.EntityMountEvent mountEvent =
+                new org.bukkit.event.entity.EntityMountEvent(
+                    passenger.getBukkitEntity(),
+                    this.getBukkitEntity()
+                );
+
+            if (passenger.valid) {
+                org.bukkit.Bukkit.getPluginManager().callEvent(mountEvent);
+            }
+
+            if (mountEvent.isCancelled()) {
+                return false;
+            }
+        }
+
+        // Убираем старых пассажиров
+        for (Entity oldPassenger : List.copyOf(this.getPassengers())) {
+            oldPassenger.stopRiding();
+        }
+
+        // Сажаем новых
+        for (Entity passenger : passengers) {
+            if (passenger.isPassenger()) {
+                passenger.stopRiding();
+            }
+
+            passenger.setPose(Pose.STANDING);
+            passenger.vehicle = this;
+        }
+
+        this.setPassengers(passengers);
+
+        List<Packet> packetsToSend = Lists.newArrayList();
+        if (this instanceof LivingEntity livingEntity) {
+            MinecraftServer.getServer().getPlayerList().sendActiveEffects(livingEntity, packetsToSend::add);
+        }
+        packetsToSend.add(new net.minecraft.network.protocol.game.ClientboundSetPassengersPacket(this));
+
+        for (Entity passenger : this.passengers) {
+            if(passenger instanceof ServerPlayer player) {
+                positionRider(player);
+                player.connection.teleport(new PositionMoveRotation(player.position(), Vec3.ZERO, 0.0F, 0.0F), Relative.ROTATION);
+                for(Packet packet : packetsToSend)
+                    player.connection.send(packet);
+            }
+        }
+
+        // Advancement trigger
+        this.getIndirectPassengersStream()
+            .filter(e -> e instanceof ServerPlayer)
+            .forEach(e ->
+                CriteriaTriggers.START_RIDING_TRIGGER.trigger((ServerPlayer) e)
+            );
+
+        return true;
+    }
