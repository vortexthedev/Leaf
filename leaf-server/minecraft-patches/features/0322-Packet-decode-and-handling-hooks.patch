diff --git a/net/minecraft/network/PacketDecoder.java b/net/minecraft/network/PacketDecoder.java
index 7c7d51148774aa30e0b91d7ebd7cc10bc9476e75..0d6d969b57878fc6cd92698996f6b12458fa1cbb 100644
--- a/net/minecraft/network/PacketDecoder.java
+++ b/net/minecraft/network/PacketDecoder.java
@@ -21,16 +21,27 @@ public class PacketDecoder<T extends PacketListener> extends ByteToMessageDecode
     @Override
     protected void decode(final ChannelHandlerContext ctx, final ByteBuf input, final List<Object> out) throws Exception {
         int readableBytes = input.readableBytes();
+        if (!org.dreeam.leaf.network.LeafPackets.allowFrame(ctx, this.protocolInfo.id(), input.capacity(), readableBytes)) {
+            input.skipBytes(readableBytes);
+            return;
+        }
 
         Packet<? super T> packet;
+        var previousDecode = org.dreeam.leaf.network.LeafPackets.enterDecode(ctx, this.protocolInfo.id());
         try {
             packet = this.protocolInfo.codec().decode(input);
         } catch (Exception e) {
+            if (org.dreeam.leaf.network.LeafPackets.isDecodeRejected(e)) {
+                input.skipBytes(input.readableBytes());
+                return;
+            }
             if (e instanceof SkipPacketException) {
                 input.skipBytes(input.readableBytes());
             }
 
             throw e;
+        } finally {
+            org.dreeam.leaf.network.LeafPackets.exitDecode(previousDecode);
         }
 
         PacketType<? extends Packet<? super T>> packetId = packet.type();
