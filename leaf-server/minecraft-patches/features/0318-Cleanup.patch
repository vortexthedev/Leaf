-            this.length = length;
-            this.attr1 = attr1;
-            this.attr2 = attr2;
-        }
-
-        private void blink() {
-            getStyledDocument().setCharacterAttributes(start, length, SYNC_BLINK ? attr1 : attr2, true);
-        }
-    }
-}
